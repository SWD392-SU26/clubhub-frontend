{
  "rewrites": [
    {
      "source": "/api-proxy/:path*",
      "destination": "http://clubhub-1.ap-southeast-1.elasticbeanstalk.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
